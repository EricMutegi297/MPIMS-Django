SECRET_KEY=your-secret-key-here
# Required: generate a unique key with Fernet.generate_key(); never reuse SECRET_KEY.
FIELD_ENCRYPTION_KEY=
FIELD_ENCRYPTION_OLD_KEYS=
CASE_DOCUMENT_MAX_UPLOAD_BYTES=26214400
CASE_UPLOAD_CLAMAV_ENABLED=False
CASE_UPLOAD_CLAMAV_HOST=127.0.0.1
CASE_UPLOAD_CLAMAV_PORT=3310
CASE_UPLOAD_CLAMAV_TIMEOUT=10
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://mpims_user:mpims_pass@localhost:5432/mpims_db
DB_SSLMODE=prefer
# Use verify-full in production; configure the trusted CA path when required.
DB_SSLROOTCERT=
CORS_ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-gmail-app-password
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=MPIMS <your-email@gmail.com>
CELERY_BROKER_URL=redis://localhost:6379/0
# TOTP is mandatory for all roles; this legacy setting is ignored by the backend.
TOTP_REQUIRED=True
TOTP_ISSUER_NAME=MPIMS
TOTP_CODE_WINDOW=1
TOTP_SETUP_TOKEN_LIFETIME_MINUTES=30
TOTP_LOCKOUT_MINUTES=15
LOGIN_FAILURE_LIMIT=5
LOGIN_IP_FAILURE_LIMIT=25
LOGIN_FAILURE_WINDOW_MINUTES=15
LOGIN_LOCKOUT_MINUTES=15
PASSWORD_RESET_RATE_LIMIT=3
PASSWORD_RESET_IP_RATE_LIMIT=10
PASSWORD_RESET_RATE_WINDOW_MINUTES=15
PASSWORD_RESET_LOCKOUT_MINUTES=15
PASSWORD_RESET_CONFIRM_FAILURE_LIMIT=10
PASSWORD_RESET_CONFIRM_IP_FAILURE_LIMIT=50
PASSWORD_RESET_CONFIRM_WINDOW_MINUTES=15
PASSWORD_RESET_CONFIRM_LOCKOUT_MINUTES=15
